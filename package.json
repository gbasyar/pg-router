{
  "name": "pg-router",
  "version": "1.1.1",
  "description": "Smart Open-Source Indonesian Payment Gateway Router & Fee Optimizer",
  "author": "Jun <gbasyar>",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "pg-router": "dist/cli/index.js",
    "pgrouter": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/cli/index.ts",
    "test": "vitest run",
