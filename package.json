  "keywords": [
    "payment-gateway",
    "indonesia",
    "qris",
    "smart-router",
    "pakasir",
    "tripay",
    "midtrans",
    "duitku",
    "xendit",
    "ipaymu"
  ],
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.14.14",
    "eslint": "^10.9.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbasyar/pg-router.git"
  },
  "homepage": "https://github.com/gbasyar/pg-router#readme",
  "bugs": {
    "url": "https://github.com/gbasyar/pg-router/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "docs"
  ],
  "directories": {
    "doc": "docs"
  },
  "type": "commonjs"
}
